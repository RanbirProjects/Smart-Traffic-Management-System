{
  "name": "smart-traffic-management-system",
  "version": "1.0.0",
  "description": "A comprehensive real-time traffic management system built with MERN stack",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npm run build",
    "build:client": "cd client && npm run build",
    "install:client": "cd client && npm install",
    "install:server": "npm install",
    "install:all": "npm install && cd client && npm install",
    "heroku-postbuild": "npm run install:client && npm run build:client"
  },
  "keywords": [
    "traffic",
    "management",
    "mern",
    "react",
    "nodejs",
    "mongodb",
    "express",
    "real-time",
    "socket.io"
  ],
  "author": "Ranbir Singh",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.7.2",
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.0"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RanbirProjects/Smart-Traffic-Management-System.git"
  },
  "bugs": {
    "url": "https://github.com/RanbirProjects/Smart-Traffic-Management-System/issues"
  },
  "homepage": "https://github.com/RanbirProjects/Smart-Traffic-Management-System#readme"
} 